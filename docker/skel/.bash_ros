# ROS 2 environment (sourced from ~/.bashrc)
# Workspace setup already sources its captured underlays, including ROS.
if [ -f ~/ws/install/setup.bash ]; then
  source ~/ws/install/setup.bash
else
  source /opt/ros/jazzy/setup.bash
fi
if [[ $- == *i* ]] && [ -f /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash ]; then
  source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash
fi

cb() {  # cached build + compile_commands.json for C++ IntelliSense
  cd ~/ws || return
  bash /opt/rosdev/build.sh "$@" || return
  [ ! -f install/setup.bash ] || source install/setup.bash
}
cbp() { cb --packages-select "$@"; }
alias ct='cd ~/ws && colcon test && colcon test-result --verbose'
alias rdi='cd ~/ws && rosdep install --from-paths src --ignore-src -r -y'
cd ~/ws 2>/dev/null
