#!/usr/bin/env bash
# ROS 2 + MoveIt on Apple's container runtime (Apple Silicon, macOS 26+).
set -euo pipefail
CALL_DIR=$PWD
cd "$(dirname "$(realpath "$0")")"
ROOT=$PWD

# Read data, never execute .env as shell code. Exported variables take precedence.
setting() {
  local value
  value=$(printenv "$1" 2>/dev/null || true)
  if [ -z "$value" ] && [ -f .env ]; then
    value=$(sed -n "s/^$1=//p" .env | tail -1)
    value=${value%$'\r'}
    case "$value" in \"*\") value=${value:1:${#value}-2} ;; \'*\') value=${value:1:${#value}-2} ;; esac
  fi
  printf '%s\n' "${value:-$2}"
}
set_env() {
  touch .env
  grep -v "^$1=" .env > .env.tmp || true
  printf '%s=%s\n' "$1" "$2" >> .env.tmp
  mv .env.tmp .env
}
ws_dir() {
  local w
  w=$(setting ROS2_WS ./ws); w=${w/#\~/$HOME}
  case "$w" in /*) ;; *) w="$ROOT/$w" ;; esac
  (cd "$w" 2>/dev/null && pwd -P) || printf '%s\n' "$w"
}
fail() { echo "$*" >&2; exit 1; }
# The installer copies workspace.example/CLAUDE.md into new workspaces once. Point
# out an unmodified older copy; never touch a file the user has edited.
workspace_notes() {
  local file template blob
  file="$(ws_dir)/CLAUDE.md"; template="$ROOT/workspace.example/CLAUDE.md"
  [ -f "$file" ] && [ -f "$template" ] && ! cmp -s "$file" "$template" || return 0
  command -v git >/dev/null && [ -e "$ROOT/.git" ] || return 0
  blob=$(git -C "$ROOT" hash-object "$file")
  git -C "$ROOT" log --format=%H -- workspace.example/CLAUDE.md | while read -r commit; do
    git -C "$ROOT" rev-parse -q --verify "$commit:workspace.example/CLAUDE.md" 2>/dev/null || true
  done | grep -qx "$blob" || return 0
  echo "Note: $file is an older copy of the agent instructions (you have not edited it)."
  echo "Update it with: cp '$template' '$file'"
}
NAME=$(setting ROS2_CONTAINER ros2)
CPUS=$(setting ROS2_CPUS 6)
MEMORY=$(setting ROS2_MEMORY 8G)
DNS=$(setting ROS2_DNS '')
BUILD_ARGS=(--cpus "$CPUS" --memory "$MEMORY")
[ -z "$DNS" ] || BUILD_ARGS+=(--dns "$DNS")
DESKTOP_PORT=$(setting ROS2_DESKTOP_PORT 6080)
CODE_PORT=$(setting ROS2_CODE_PORT 8080)
for port in "$DESKTOP_PORT" "$CODE_PORT"; do
  [[ "$port" =~ ^[1-9][0-9]{0,4}$ ]] && [ "$port" -le 65535 ] || fail "Invalid service port: $port"
done
[ "$DESKTOP_PORT" != "$CODE_PORT" ] || fail 'Desktop and editor ports must be different.'
[[ "$CPUS" =~ ^[1-9][0-9]*$ ]] || fail "ROS2_CPUS must be a positive integer: $CPUS"
[[ "$MEMORY" =~ ^[1-9][0-9]*[kKmMgGtTpP]?$ ]] || fail "Invalid ROS2_MEMORY: $MEMORY (example: 8G)"
URL="http://localhost:$DESKTOP_PORT/vnc.html?autoconnect=1&resize=scale"
STATE="$ROOT/local/.rosdev"
BASE_IMAGE=$(setting ROS2_DEV_IMAGE "")
if [ -z "$BASE_IMAGE" ]; then
  if [ -n "$(setting ROS2_DEV_TAG '')" ]; then BASE_IMAGE="ghcr.io/davidseysergit/ros2-dev:$(setting ROS2_DEV_TAG '')"
  elif [ -f "$STATE/base-image" ]; then BASE_IMAGE=$(cat "$STATE/base-image")
  else BASE_IMAGE="ghcr.io/davidseysergit/ros2-dev:$(setting ROS2_DEV_TAG latest)"; fi
fi
ROOT_ID=$(printf '%s' "$ROOT" | shasum -a 256 | cut -c1-16)
LOCAL_IMAGE="ros2-dev-local:$ROOT_ID"
BUILT_IMAGE="ros2-dev:local-$ROOT_ID"

ensure_runtime() {
  command -v container >/dev/null || fail "Apple container is missing. Install it with: brew install container"
  container system status >/dev/null 2>&1 || container system start --enable-kernel-install
  mkdir -p "$STATE"
}
inspect_container() { container inspect "$NAME" 2>/dev/null; }
assert_owned() {
  local info owner
  info=$(inspect_container) || return 0
  owner=$(printf '%s' "$info" | python3 -c 'import json,sys; print(json.load(sys.stdin)[0]["configuration"].get("labels",{}).get("rosdev.root",""))')
  [ "$owner" = "$ROOT" ] || fail "Container '$NAME' belongs to another setup. Set ROS2_CONTAINER to a different name."
}
container_state() {
  inspect_container | python3 -c 'import json,sys; print(json.load(sys.stdin)[0]["status"]["state"])' 2>/dev/null || true
}
image_digest() {
  container image inspect "$1" | python3 -c 'import json,sys; print(json.load(sys.stdin)[0]["configuration"]["descriptor"]["digest"])'
}
# Hash only the overlay build context, not generated runtime state.
local_key() {
  python3 - "$1" <<'PY'
import hashlib, os, sys
h = hashlib.sha256(sys.argv[1].encode())
for root, dirs, files in os.walk('local'):
    dirs[:] = sorted(d for d in dirs if d not in ('.rosdev', '.git', '__pycache__'))
    for name in sorted(files):
        if root == 'local' and name in ('workspaces', 'workspaces.tmp', 'compose.yaml'): continue
        path = os.path.join(root, name)
        h.update(path.encode())
        if os.path.islink(path): h.update(os.readlink(path).encode())
        else:
            with open(path, 'rb') as f:
                for block in iter(lambda: f.read(1024 * 1024), b''): h.update(block)
        h.update(str(os.stat(path).st_mode).encode())
print(h.hexdigest())
PY
}
prepare_image() {
  container image inspect "$BASE_IMAGE" >/dev/null 2>&1 || container image pull --platform linux/arm64 "$BASE_IMAGE"
  IMAGE=$BASE_IMAGE
  if [ -f local/Dockerfile ]; then
    local key old_key
    key=$(local_key "$(image_digest "$BASE_IMAGE")")
    old_key=$(cat "$STATE/local-key" 2>/dev/null || true)
    if [ "$key" != "$old_key" ] || ! container image inspect "$LOCAL_IMAGE" >/dev/null 2>&1; then
      echo "Building your additions..."
      container build "${BUILD_ARGS[@]}" --build-arg "BASE=$BASE_IMAGE" -t "$LOCAL_IMAGE" -f local/Dockerfile local
      printf '%s\n' "$key" > "$STATE/local-key"
    fi
    IMAGE=$LOCAL_IMAGE
  fi
}
exec_ros() { container exec "$NAME" bash -lc "$1" bash "${@:2}"; }
wait_desktop() {
  local i
  for ((i=0; i<150; i++)); do
    if curl --connect-timeout 1 --max-time 1 -fs -o /dev/null "http://127.0.0.1:$DESKTOP_PORT/vnc.html"; then return; fi 2>/dev/null
    sleep 0.2
  done
  fail "Desktop did not become ready. Check: rosdev logs"
}
up_container() {
  ensure_runtime
  prepare_image
  local w workspace_id key old_key current info owner used_ports
  w=$(ws_dir); mkdir -p "$w/src"; w=$(cd "$w" && pwd -P)
  workspace_id=$(printf '%s' "$w" | shasum -a 256 | cut -c1-16)
  local args=(--detach --name "$NAME" --cpus "$CPUS" --memory "$MEMORY" --shm-size 2G
    --publish "127.0.0.1:$DESKTOP_PORT:6080" --publish "127.0.0.1:$CODE_PORT:8080"
    --env "RESOLUTION=$(setting RESOLUTION 1920x1080)" --env "ROS_DOMAIN_ID=$(setting ROS_DOMAIN_ID 0)"
    --volume "$w:/home/ros/ws" --volume "$ROOT/tools:/opt/rosdev:ro")
  # Persist compiler output on Linux ext4, independent of the source bind mount.
  for part in build install log; do
    args+=(--volume "rosdev-$workspace_id-$part:/home/ros/ws/$part")
  done
  args+=(--volume "rosdev-$workspace_id-ccache:/home/ros/.cache/ccache")
  [ -z "$DNS" ] || args+=(--dns "$DNS")
  used_ports=" $DESKTOP_PORT $CODE_PORT "
  for portfile in local/addons/*/ports; do
    [ -f "$portfile" ] || continue
    while IFS= read -r port || [ -n "$port" ]; do
      [[ "$port" =~ ^[1-9][0-9]{0,4}$ ]] && [ "$port" -le 65535 ] || fail "Invalid port in $portfile: $port"
      [[ "$used_ports" != *" $port "* ]] || fail "Port $port is configured more than once."
      used_ports+="$port "
      args+=(--publish "127.0.0.1:$port:$port")
    done < "$portfile"
  done
  key=$({ printf '%s\0' "${args[@]}" "$IMAGE"; image_digest "$IMAGE"; } | shasum -a 256 | cut -d' ' -f1)
  info=$(inspect_container || true)
  old_key=; current=
  if [ -n "$info" ]; then
    owner=$(printf '%s' "$info" | python3 -c 'import json,sys; print(json.load(sys.stdin)[0]["configuration"].get("labels",{}).get("rosdev.root",""))')
    [ "$owner" = "$ROOT" ] || fail "Container '$NAME' belongs to another setup. Set ROS2_CONTAINER to a different name."
    old_key=$(printf '%s' "$info" | python3 -c 'import json,sys; print(json.load(sys.stdin)[0]["configuration"].get("labels",{}).get("rosdev.config",""))')
    current=$(printf '%s' "$info" | python3 -c 'import json,sys; print(json.load(sys.stdin)[0]["status"]["state"])')
    if [ "$key" != "$old_key" ]; then
      [ "$current" != running ] || container stop "$NAME"
      container delete "$NAME"
      current=
    fi
  fi
  if [ -z "$current" ]; then
    container run "${args[@]}" --label "rosdev.root=$ROOT" --label "rosdev.config=$key" "$IMAGE"
  elif [ "$current" != running ]; then
    container start "$NAME"
  fi
  # Fresh named volumes are owned by root; only change their top-level directories.
  container exec --user root "$NAME" chown ros:ros /home/ros/ws/build /home/ros/ws/install /home/ros/ws/log /home/ros/.cache /home/ros/.cache/ccache
  # colcon's setup script probes every install subdirectory, including ext4's
  # root-owned recovery directory. Give the workspace user access to that probe.
  container exec --user root "$NAME" sh -c 'if [ -d /home/ros/ws/install/lost+found ]; then chown ros:ros /home/ros/ws/install/lost+found; fi'
  wait_desktop
}
stop_container() { assert_owned; [ "$(container_state)" != running ] || container stop "$NAME"; }
open_url() { [ "$(setting ROS2_OPEN_BROWSER 1)" = 0 ] || open "$1"; }

case "${1:-help}" in
  up) up_container; echo "Desktop: $URL"; open_url "$URL" ;;
  open) open_url "$URL" ;;
  code)
    up_container
    st=$(container exec "$NAME" supervisorctl -c /etc/supervisor/desktop.conf status code || true)
    [[ "$st" == *RUNNING* ]] || container exec "$NAME" supervisorctl -c /etc/supervisor/desktop.conf start code
    echo "VS Code: http://localhost:$CODE_PORT"
    open_url "http://localhost:$CODE_PORT/?folder=/home/ros/ws" ;;
  shell) ensure_runtime; container exec -it "$NAME" bash -l ;;
  exec) shift; [ $# -gt 0 ] || fail "Usage: rosdev exec '<command>'"; exec_ros "$*" ;;
  build) shift; exec_ros 'bash /opt/rosdev/build.sh "$@"' "$@" ;;
  new) shift; exec_ros 'bash /opt/rosdev/new_package.sh "$@"' "$@" ;;
  top) container exec -it "$NAME" bash -lc 'python3 /opt/rosdev/top.py' ;;
  test) shift; exec_ros 'bash /opt/rosdev/test.sh "$@"' "$@" ;;
  start)
    [ $# -ge 3 ] || fail "Usage: rosdev start NAME '<command>'"
    shift; exec_ros 'bash /opt/rosdev/jobs.sh start "$@"' "$@" ;;
  launch)
    [ $# -ge 4 ] || fail 'Usage: rosdev launch NAME PKG FILE [launch args...]'
    shift; exec_ros 'bash /opt/rosdev/jobs.sh start "$1" ros2 launch "${@:2}"' "$@" ;;
  jobs) shift; exec_ros 'bash /opt/rosdev/jobs.sh list "$@"' "$@" ;;
  stop)
    [ $# -ge 2 ] || fail 'Usage: rosdev stop NAME | --all'
    exec_ros 'bash /opt/rosdev/jobs.sh stop "$1"' "$2" ;;
  screenshot)
    shift
    out=''; opts=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --region|--scale) opts+=("$1" "${2:?$1 needs a value}"); shift ;;
        -*) fail "Unknown option: $1 (use --region X,Y,W,H or --scale F)" ;;
        *) out=$1 ;;
      esac
      shift
    done
    [ -n "$out" ] || out="${TMPDIR:-/tmp}/rosdev-screenshot-$(date +%Y%m%d-%H%M%S).png"
    case "$out" in /*) ;; *) out="$CALL_DIR/$out" ;; esac
    # No login shell: its startup output would end up inside the PNG.
    container exec "$NAME" env DISPLAY=:1 python3 /opt/rosdev/screenshot.py "${opts[@]}" > "$out.part" \
      || { rm -f "$out.part"; fail 'Screenshot failed.'; }
    [ "$(head -c 4 "$out.part" | od -An -c | tr -d ' ')" = '211PNG' ] \
      || { rm -f "$out.part"; fail 'Screenshot failed: the container did not return a PNG.'; }
    mv "$out.part" "$out"
    echo "$out" ;;
  down) stop_container ;;
  restart) stop_container; up_container ;;
  logs)
    if [ $# -ge 2 ]; then shift; exec_ros 'bash /opt/rosdev/jobs.sh log "$@"' "$@"
    else container logs --follow "$NAME"; fi ;;
  status) container system status; container list --all ;;
  stop-vm) stop_container; container builder stop 2>/dev/null || true ;;
  rebuild)
    ensure_runtime
    BASE_IMAGE=$BUILT_IMAGE
    container build "${BUILD_ARGS[@]}" --pull -t "$BASE_IMAGE" .
    printf '%s\n' "$BASE_IMAGE" > "$STATE/base-image"
    up_container ;;
  update)
    ensure_runtime
    git pull --ff-only
    workspace_notes
    if [ "$BASE_IMAGE" = "$BUILT_IMAGE" ]; then exec "$ROOT/rosdev" rebuild; fi
    container image pull --platform linux/arm64 "$BASE_IMAGE"
    up_container ;;
  ws)
    case "${2:-}" in
      '') ws_dir ;;
      list)
        cur=$(ws_dir)
        { echo "$cur"; cat local/workspaces 2>/dev/null || true; } | awk 'NF && !seen[$0]++' | while IFS= read -r w; do
          [ "$w" = "$cur" ] && printf '* %s\n' "$w" || printf '  %s\n' "$w"
        done ;;
      use)
        w=${3:?usage: rosdev ws use <folder>}; w=${w/#\~/$HOME}
        case "$w" in /*) ;; *) w="$CALL_DIR/$w" ;; esac
        mkdir -p "$w/src"; w=$(cd "$w" && pwd -P)
        mkdir -p local
        { ws_dir; cat local/workspaces 2>/dev/null || true; echo "$w"; } | awk 'NF && !seen[$0]++' > local/workspaces.tmp
        mv local/workspaces.tmp local/workspaces
        set_env ROS2_WS "$w"
        unset ROS2_WS # the selected path takes effect even if the caller exported a previous one
        echo "Workspace: $w"
        up_container ;;
      *) fail 'Usage: rosdev ws [list | use <folder>]' ;;
    esac ;;
  addon)
    case "${2:-list}" in
      list)
        for d in addons/*/; do
          [ -d "$d" ] || continue
          n=$(basename "$d")
          [ -d "local/addons/$n" ] && echo "  [on]  $n" || echo "  [off] $n"
        done ;;
      add|remove)
        n=${3:?usage: rosdev addon add|remove <name>}
        [[ "$n" =~ ^[a-zA-Z0-9_-]+$ ]] && [ -d "addons/$n" ] || fail "Unknown add-on: $n"
        mkdir -p local
        [ -f local/Dockerfile ] || cp local.example/Dockerfile local/Dockerfile
        python3 - "$n" "$2" <<'PY'
import pathlib, sys
name, action = sys.argv[1:]
begin, end = f'# >>> addon {name}', f'# <<< addon {name}'
p = pathlib.Path('local/Dockerfile')
s = p.read_text()
if begin in s:
    start = s.index(begin)
    finish = s.index(end, start) + len(end)
    s = s[:start] + s[finish:].lstrip('\n')
if action == 'add':
    s = s.rstrip('\n') + f'\n\n{begin}\n' + pathlib.Path(f'addons/{name}/Dockerfile.part').read_text().rstrip('\n') + f'\n{end}\n'
p.write_text(s)
PY
        rm -rf "local/addons/$n"
        if [ "$2" = add ]; then mkdir -p local/addons; cp -R "addons/$n" "local/addons/$n"; fi
        up_container ;;
      *) fail 'Usage: rosdev addon list|add|remove <name>' ;;
    esac ;;
  doctor)
    fails=0
    check() { if "$@"; then echo "  OK: $*"; else echo "  FAIL: $*"; fails=$((fails+1)); fi; }
    check container system status
    check test "$(container_state)" = running
    check test -d "$(ws_dir)/src"
    check curl --max-time 2 -fs -o /dev/null "http://127.0.0.1:$DESKTOP_PORT/vnc.html"
    check exec_ros 'ros2 pkg prefix moveit_ros_move_group && ros2 pkg prefix rviz2'
    check container exec "$NAME" supervisorctl -c /etc/supervisor/desktop.conf status xvnc desktop novnc
    check exec_ros 'test -w ~/ws/build && test -w ~/ws/install && test -w "$CCACHE_DIR"'
    workspace_notes
    [ "$fails" = 0 ] || fail "$fails check(s) failed. Try rosdev up; inspect rosdev logs."
    echo 'All checks passed.' ;;
  uninstall)
    stop_container
    if inspect_container >/dev/null; then container delete "$NAME"; fi
    echo "Removed container $NAME. Workspace, images, volumes and settings are kept."
    echo 'To remove cached data explicitly: container volume list' ;;
  *) cat <<'USAGE'
Usage: rosdev <command>
  up                 start the container and open the desktop
  open               open the browser desktop
  code               start and open VS Code in the browser
  shell              ROS-sourced shell
  exec '<command>'   run a command inside the container
  build [args]       colcon build with persistent compiler caching
  new NAME [python|cpp]  create and build a package
  top                live nodes, topics, CPU and RAM
  test [PKG...] [--filter F] [--timeout S] [--mem 4G] [--json]
                     build and test in a private ROS domain; print a short summary
  launch NAME PKG FILE [args]   run a launch file in the background as job NAME
  start NAME '<command>'        run any command in the background as job NAME
  jobs [--json]      list background jobs
  logs NAME [-f] [-n N]         show a job's output (without NAME: container logs)
  stop NAME | --all  stop background jobs (Ctrl-C first, then harder)
  screenshot [FILE] [--region X,Y,W,H] [--scale F]
                     save a PNG of the desktop and print its path
  ws [list|use DIR]   show or switch workspaces
  addon list|add NAME|remove NAME
  down               stop the container, keeping its writable filesystem
  restart            restart with current settings
  rebuild            build this checkout's image and restart
  update             update the checkout and image, then restart
  status | doctor
  stop-vm            stop this container and the image builder
  uninstall          remove this container, preserve workspace and cached data
USAGE
    ;;
esac
