#!/usr/bin/env bash
# Helper for the ROS 2 Jazzy + MoveIt browser-desktop container.
set -euo pipefail
cd "$(dirname "$(realpath "$0")")"  # works via the global symlink too

ensure_vm() {
  if ! colima status >/dev/null 2>&1; then
    echo "Starting Colima VM..."
    colima start
  fi
}

case "${1:-help}" in
  up)      ensure_vm; docker compose up -d --build
           echo "Desktop: http://localhost:6080/vnc.html?autoconnect=1&resize=scale"
           sleep 3; open "http://localhost:6080/vnc.html?autoconnect=1&resize=scale" ;;
  open)    open "http://localhost:6080/vnc.html?autoconnect=1&resize=scale" ;;
  down)    docker compose down ;;
  restart) ensure_vm; docker compose restart ;;
  shell)   ensure_vm; docker compose exec -it ros2 bash -l ;;
  build)   docker compose exec ros2 bash -lc 'cd ~/ws && colcon build --symlink-install' ;;
  rebuild) ensure_vm; docker compose build --pull && docker compose up -d ;;
  logs)    docker compose logs -f ;;
  status)  colima status; docker compose ps ;;
  stop-vm) docker compose down; colima stop ;;
  doctor)
           G=$'\033[32m'; Y=$'\033[33m'; Rd=$'\033[31m'; N=$'\033[0m'; fails=0
           ok()   { printf "  ${G}✓${N} %s\n" "$1"; }
           warn() { printf "  ${Y}!${N} %s\n    ${Y}→${N} %s\n" "$1" "$2"; }
           bad()  { printf "  ${Rd}✗${N} %s\n    ${Y}→${N} %s\n" "$1" "$2"; fails=$((fails+1)); }
           echo "rosdev doctor"
           [ "$(uname -m)" = arm64 ] && ok "Apple Silicon (native arm64)" || warn "Intel Mac" "works, but slower"
           for t in colima docker git; do
             command -v $t >/dev/null && ok "$t installed" || bad "$t missing" "brew install $t"
           done
           docker compose version >/dev/null 2>&1 && ok "docker compose plugin" \
             || bad "docker compose plugin not found" "add \"cliPluginsExtraDirs\": [\"$(brew --prefix)/lib/docker/cli-plugins\"] to ~/.docker/config.json"
           if colima status >/dev/null 2>&1; then
             ok "Colima VM running ($(colima list -j 2>/dev/null | head -1 | python3 -c "import json,sys; d=json.load(sys.stdin); print(d['cpus'], 'CPU,', d['memory']>>30, 'GB RAM')" 2>/dev/null || echo '?'))"
             ctx=$(docker context show 2>/dev/null)
             [ "$ctx" = colima ] && ok "docker context: colima" || bad "docker context is '$ctx'" "docker context use colima"
             df=$(colima ssh -- df -BG --output=avail /var/lib/docker 2>/dev/null | tail -1 | tr -dc 0-9)
             [ -n "$df" ] && { [ "$df" -ge 10 ] && ok "VM disk free: ${df} GB" || warn "VM disk free: ${df} GB" "docker system prune"; }
             if docker image inspect ros2-jazzy-desktop >/dev/null 2>&1; then ok "image built"; else bad "image not built" "rosdev up"; fi
             if [ "$(docker inspect -f '{{.State.Running}}' ros2 2>/dev/null)" = true ]; then
               ok "container running"
               st=$(docker compose exec -T ros2 supervisorctl -c /etc/supervisor/desktop.conf status 2>/dev/null)
               for p in xvnc desktop novnc; do
                 grep -q "^$p .*RUNNING" <<<"$st" && ok "service $p" || bad "service $p not running" "rosdev restart (logs: docker compose exec ros2 ls /tmp)"
               done
               docker compose exec -T ros2 bash -lc 'ros2 pkg prefix moveit_planners_stomp >/dev/null' && ok "ROS 2 + MoveIt (STOMP) available" || bad "ROS/MoveIt not found in container" "rosdev rebuild"
             else
               bad "container not running" "rosdev up"
             fi
           else
             bad "Colima VM not running" "colima start"
           fi
           curl -fs -o /dev/null http://localhost:6080/vnc.html && ok "browser desktop reachable: http://localhost:6080" || bad "port 6080 not reachable" "rosdev up; check nothing else uses 6080 (lsof -i :6080)"
           [ -d ws/src ] && ok "workspace: $(pwd)/ws ($(find ws/src -name package.xml -not -path "*/build/*" | wc -l | tr -d ' ') packages)"
           [ -L "$(brew --prefix)/bin/rosdev" ] && ok "global 'rosdev' command" || warn "no global 'rosdev' command" "ln -sf $(pwd)/rosdev $(brew --prefix)/bin/rosdev"
           echo; [ $fails -eq 0 ] && echo "  ${G}All good.${N}" || { echo "  ${Rd}$fails problem(s) found.${N}"; exit 1; } ;;
  update)  ensure_vm
           git pull --ff-only
           docker compose build --pull
           docker compose up -d
           echo "Updated. Desktop: http://localhost:6080/vnc.html?autoconnect=1&resize=scale" ;;
  uninstall)
           ask() { read -r -p "$1 [y/N] " a </dev/tty; [[ "$a" =~ ^[Yy]$ ]]; }
           echo "Uninstalling ROS 2 dev environment. Each step asks first."
           if colima status >/dev/null 2>&1; then
             docker compose down --rmi all --volumes || true
           fi
           if ask "Delete the Colima VM (frees disk; removes ALL images/containers in it)?"; then
             colima delete --force
           fi
           if ask "Uninstall colima + docker CLI via Homebrew?"; then
             brew uninstall colima docker-compose docker-buildx docker || true
           fi
           if ask "Delete this folder $(pwd) INCLUDING your code in ws/src?"; then
             if [ -n "$(git status --porcelain 2>/dev/null)" ] || [ -n "$(git log @{u}.. 2>/dev/null)" ]; then
               echo "  Warning: uncommitted or unpushed changes here."
               ask "  Really delete anyway?" || { echo "Kept folder."; exit 0; }
             fi
             dir=$(pwd); cd ..; rm -rf "$dir"; echo "Deleted $dir"
             rm -f "$(brew --prefix)/bin/rosdev"
           fi
           echo "Done." ;;
  *) cat <<USAGE
Usage: rosdev <command>
  up        start VM + container, open the desktop in the browser
  open      open the browser desktop
  shell     bash shell inside the container (ROS sourced)
  build     colcon build the workspace (ws/)
  down      stop the container
  restart   restart the container
  rebuild   rebuild the image from scratch (pull newer base)
  logs      follow container logs
  status    VM + container status
  stop-vm   stop container and the Colima VM (frees RAM)
  doctor    check the whole setup and suggest fixes
  update    git pull + rebuild image + restart
  uninstall remove container/image, optionally VM, tools and this folder (asks each step)
USAGE
  ;;
esac
